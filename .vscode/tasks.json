{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run frontend dev server",
			"type": "shell",
			"command": "cd frontend && npm run dev",
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run backend dev server",
			"type": "shell",
			"command": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
			"isBackground": true,
			"group": "build"
		}
	]
}